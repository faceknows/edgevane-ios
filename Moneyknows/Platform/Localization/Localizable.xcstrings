      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        }
      }
    },
    "• %@" : {
      "comment" : "A bullet point followed by a list item. The argument is the list item.",
      "isCommentAutoGenerated" : true
    },
