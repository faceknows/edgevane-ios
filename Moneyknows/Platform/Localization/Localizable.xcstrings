    "—" : {
      "comment" : "A placeholder value for a value that is not yet available.",
      "isCommentAutoGenerated" : true
    },
    "%@" : {

    },
    "%@ · %@" : {
      "comment" : "A secondary line of text that shows the quantity and whether a position is long or short.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@: %@" : {
      "comment" : "A label displaying the source of the event. The argument is the source name.",
